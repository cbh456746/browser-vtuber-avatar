{
  "name": "illustration-avatar-studio",
  "productName": "Illustration Avatar Studio",
  "version": "0.2.3",
  "private": true,
  "description": "한 장의 일러스트로 제작하는 로컬 방송 아바타와 안전한 에이전트 워크플로우",
  "type": "module",
  "main": "desktop/main.mjs",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:vts": "node --test tests/vts-integration.test.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "avatar:build": "node scripts/build-avatar.mjs",
    "avatar:check": "node scripts/check-avatar.mjs",
    "package:win": "node scripts/package-win.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "format": "prettier --write app desktop scripts tests docs README.md AGENTS.md SECURITY.md NOTICE.md ASSET_POLICY.md .github package.json",
    "format:check": "prettier --check app desktop scripts tests docs README.md AGENTS.md SECURITY.md NOTICE.md ASSET_POLICY.md .github package.json"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "electron": "44.9.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
